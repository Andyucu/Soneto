<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 2 item 4: lets Soneto.Core.Tests directly unit-test DictionaryEngineProcessor's
         internal static ApplyCasing helper (the §2.5 rule 3 casing decision logic) without
         making it a public API surface. -->
    <InternalsVisibleTo Include="Soneto.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Phase 3 item 1 (§3.5): SQLite/FTS5-backed IHistoryStore. Pure managed/P-Invoke,
         no platform-specific surface, so it legitimately lives in Soneto.Core per this
         project's "no platform assembly referenced" rule. Pinned to the net10.0-aligned
         major version, matching this file's other 10.0.0 pins. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Direct override of the transitive SQLitePCLRaw.bundle_e_sqlite3 dependency Microsoft.Data.Sqlite
         10.0.0 otherwise pulls in (2.1.11), which carries a known high-severity NU1903 advisory
         (GHSA-2m69-gcr7-jv3q). 3.0.5 is a patched release with no compatibility issues observed. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- System.Text.Json (per §1.2's package table) ships as part of the net10.0 shared
         framework; an explicit PackageReference triggers NU1510 ("will not be pruned")
         and adds nothing, so it's used directly without one. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Plan §1.6 warm-up clip: ~1s of real recorded speech (trimmed from the
         sherpa-onnx model release's own test_wavs/en.wav — a JFK quote), NOT silence.
         See SherpaOnnxTranscriber's warm-up step. -->
    <EmbeddedResource Include="Asr\Resources\warmup-en.wav" LogicalName="Soneto.Core.Asr.Resources.warmup-en.wav" />

    <!-- Plan §1.5 VAD: Silero's own ONNX model, ~630KB, tiny compared to the ~640MB ASR
         model, so unlike ModelManager's download/hash-verify/extract story for the ASR
         model, this ships as a plain embedded resource in the assembly itself (no
         first-run download, no ModelManager involvement). Fetched from the same
         k2-fsa/sherpa-onnx release feed used by the ASR model
         (https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx),
         see SileroVadDetector's class doc comment for the exact provenance/hash. -->
    <EmbeddedResource Include="Asr\Resources\silero_vad.onnx" LogicalName="Soneto.Core.Asr.Resources.silero_vad.onnx" />

    <!-- Phase 2 item 8 (§2.8): hand-curated, deliberately non-exhaustive EN/RO common-word
         lists used only for the authoring-time collision-warning check; see
         WordFrequencyList's class doc comment for scope/provenance. Plain embedded text
         resources, one word per line, same convention as the two entries above. -->
    <EmbeddedResource Include="Dictionary\Resources\common-words-en.txt" LogicalName="Soneto.Core.Dictionary.Resources.common-words-en.txt" />
    <EmbeddedResource Include="Dictionary\Resources\common-words-ro.txt" LogicalName="Soneto.Core.Dictionary.Resources.common-words-ro.txt" />

    <!-- Phase 2 item 10 (§2.10): the seed dictionary shipped as dictionary.json's default
         content on first run (see SeedDictionary/DictionaryService). Same plain
         embedded-resource convention as the entries above. -->
    <EmbeddedResource Include="Dictionary\Resources\seed-dictionary.json" LogicalName="Soneto.Core.Dictionary.Resources.seed-dictionary.json" />
  </ItemGroup>

</Project>
