<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Elevation tokens (§3.7): corner radius and shadow tokens for cards/panels
       (the future History list's entries, the Permissions Doctor's status cards) —
       a small number of named levels, not per-view ad-hoc values. -->

  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">16</CornerRadius>

  <!-- BoxShadows resources: a soft card shadow and a slightly stronger "raised"
       shadow for elements that should read as sitting above the surface (e.g. a
       popover or a dragged card). -->
  <BoxShadows x:Key="ShadowCard">0 1 4 0 #33000000</BoxShadows>
  <BoxShadows x:Key="ShadowRaised">0 4 12 0 #40000000</BoxShadows>

  <!-- Hairline border thickness: the one border-width value this app uses (e.g. a
       swatch's outline against Border). Kept here, not in Spacing.axaml, since it's a
       shape/elevation concern (how a surface's edge reads), not a layout-gap concern. -->
  <Thickness x:Key="BorderThicknessHairline">1</Thickness>

  <!-- Component sizing tokens, added post-review (item 3): KitchenSinkView.axaml's own
       swatches/demo bars/cards originally hardcoded Width/Height (64x48, 32, 200) with no
       token to reach for, which is exactly the magic-number pattern §3.7's discipline exists
       to prevent. Named by ROLE (what kind of component), not by raw pixel value, so a
       future view reaching for "how big should a color swatch be" finds an answer here
       instead of picking a new number. -->
  <x:Double x:Key="SizeSwatchWidth">64</x:Double>
  <x:Double x:Key="SizeSwatchHeight">48</x:Double>
  <x:Double x:Key="SizeDemoBarHeight">32</x:Double>
  <x:Double x:Key="SizeDemoCardWidth">200</x:Double>

  <!-- Added item 4 (§3.8, main window nav-rail shell): same "named by role" discipline
       as the item-3 sizing tokens above — the nav rail's fixed width had no existing
       token to reach for. -->
  <x:Double x:Key="SizeNavRailWidth">200</x:Double>

  <!-- Added item 5 (§3.9, Recording HUD): the HUD window's fixed size and the level
       meter's track dimensions — same "named by role" discipline as every prior
       component-sizing token above. -->
  <x:Double x:Key="SizeHudWidth">220</x:Double>
  <x:Double x:Key="SizeHudHeight">64</x:Double>
  <x:Double x:Key="SizeHudMeterWidth">188</x:Double>
  <x:Double x:Key="SizeHudMeterHeight">10</x:Double>

  <!-- Added item 7 (§3.11, Dictionary editor): the entry-list column vs. the add/edit form
       panel's fixed widths — same "named by role" discipline as every prior component-sizing
       token above. -->
  <x:Double x:Key="SizeDictionaryListWidth">280</x:Double>
  <x:Double x:Key="SizeDictionaryFormWidth">340</x:Double>

  <!-- Added item 10 (§3.14, data & privacy controls): the panic-wipe confirmation dialog's
       fixed width — same "named by role" discipline as every prior component-sizing token
       above. -->
  <x:Double x:Key="SizeConfirmDialogWidth">380</x:Double>

</ResourceDictionary>
