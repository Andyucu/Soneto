<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- No package references: raw P/Invoke against /dev/input/event*, plus process
       calls to wl-copy / ydotool for clipboard and injection (plan §1.2, §S5). -->

  <ItemGroup>
    <ProjectReference Include="..\Soneto.Core\Soneto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Soneto.Platform.Linux.Tests reach internal-but-unit-testable types (e.g.
         EvdevInterop's pure EVIOCGBIT macro arithmetic) directly, mirroring
         Soneto.Platform.Windows's identical InternalsVisibleTo convention. -->
    <InternalsVisibleTo Include="Soneto.Platform.Linux.Tests" />
  </ItemGroup>

</Project>
